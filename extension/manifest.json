{
  "manifest_version": 3,
  "name": "Türkçe Otomatik Düzeltici (0-Token, TDK)",
  "version": "1.0.0",
  "description": "Yerel Türkçe Otomatik Düzeltici motorunu kullanarak tarayıcıdaki tüm metin kutularında anında TDK imla ve yazım düzeltmesi yapar.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Türkçe Otomatik Düzeltici"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
